# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Put your real key ONLY in a local, untracked .env file (it is git-ignored). Never commit it and
# never prefix it with VITE_. The placeholder below is treated as "missing" by the server.
GEMINI_API_KEY=YOUR_ACTUAL_API_KEY
GEMINI_MODEL=your_actual_model
# GEMINI_MODEL (optional): Gemini model used by Ask SAHAYINI. Defaults to gemini-3.8-flash.
# Gemini 2.5 models are no longer available to new API keys, so do not set gemini-2.5-*.
# GEMINI_MODEL="gemini-3.8-flash"
# Fallbacks (verified stable Flash models, tried automatically on 503/429): gemini-3.6-flash, gemini-3.5-flash-lite.
# To see which models YOUR key can use, run: npm run check:ai

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY (optional, SERVER-SIDE ONLY): enables Google Places API (New) for the
# "Find Nearby Police Stations" card. Never prefix with VITE_ and never put it in frontend code.
# Without it, the server uses OpenStreetMap data (no key needed, less complete phone/hours data).
GOOGLE_MAPS_API_KEY=""
